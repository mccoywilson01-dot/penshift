# ═══════════════════════════════════════════════════════════════════════════════
# PenShift — Production Environment Variables Example
# Copy to .env for local development or configure in Render Dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# Node Environment
NODE_ENV=production
PORT=10000

# Supabase (Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis (Rate limiting, idempotency & state caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

# Upstash QStash (Asynchronous background worker execution)
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# Service URLs (Pointing to deployed Render Web Service)
PENSHIFT_QSTASH_WORKER_URL=https://your-service.onrender.com/api/internal/worker/generation
PENSHIFT_RECONCILE_URL=https://your-service.onrender.com/api/internal/reconcile

# Reconciliation Secret (Authorization for /api/internal/reconcile)
CRON_SECRET=your-secure-random-reconciliation-secret

# AI Providers
GEMINI_API_KEY_1=your-gemini-api-key
GEMINI_API_KEY_2=
GROQ_API_KEY_1=your-groq-api-key
GROQ_API_KEY_2=

# Research & Language Tools (Optional)
TAVILY_API_KEY=
LANGUAGETOOL_URL=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=

# Security & CORS
ALLOWED_ORIGINS=https://your-service.onrender.com,https://penshift.com
GUEST_COOKIE_SECRET=your-guest-cookie-hmac-secret
PENSHIFT_DEV_MODE=false
